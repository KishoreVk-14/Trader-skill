# Twelve Data API Key (free or paid)
TWELVE_DATA_API_KEY=

# Database path
GOLD_DB_PATH=data/gold_smc.db

# Symbols: Primary Gold instrument + Correlated SMT benchmark
GOLD_SYMBOL=XAU/USD
BENCHMARK_SYMBOL=XAG/USD

# Web Server
GOLD_WEB_HOST=127.0.0.1
GOLD_WEB_PORT=8060

# Strategy & Risk Rules
RISK_PER_TRADE_PCT=1.0
INITIAL_CAPITAL=10000.0
MAX_OPEN_POSITIONS=2
MAX_LEVERAGE=10.0
GOLD_SPREAD_USD=0.25
SL_BUFFER_ATR_MULT=0.3
MIN_RR_RATIO=1.8

# Session constraints (UTC)
USE_KILLZONES=true
LONDON_KILLZONE_START=07:00
LONDON_KILLZONE_END=10:00
NY_KILLZONE_START=12:30
NY_KILLZONE_END=15:30
